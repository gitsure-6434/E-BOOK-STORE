# Optional: where Vite should proxy /api and /uploads during npm run dev.
# Must match server PORT in ../server/.env (default here is 5001).
# VITE_API_PROXY_TARGET=http://127.0.0.1:5001

# Only if you call the API directly (no proxy). Usually leave unset in dev.
# VITE_API_URL=http://localhost:5001
