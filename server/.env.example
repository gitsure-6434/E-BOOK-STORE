PORT=5001
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/ebook-store
JWT_SECRET=change_me_to_a_long_random_string

# Stripe — leave empty in THIS template file; put real values only in your private server/.env
# STRIPE_SECRET_KEY: Dashboard → Developers → API keys → Secret key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY= 
# STRIPE_WEBHOOK_SECRET: from "stripe listen ..." (whsec_...) or from Dashboard webhook endpoint signing secret
STRIPE_WEBHOOK_SECRET=
